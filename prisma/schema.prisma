generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int           @id @default(autoincrement())
  created_at    DateTime      @default(now()) @db.Timestamptz(3)
  user_id       String        @unique @db.VarChar(255)
  email         String        @db.VarChar(255)
  username      String?       @db.VarChar(255)
  first_name    String?       @db.VarChar(255)
  last_name     String?       @db.VarChar(255)
  photo         String?       @db.Text
  blogs         Blog[]
  categories    Category[]
  comments      Comment[]
  comment_likes CommentLike[]
  blog_likes    BlogLike[]
  blog_views    BlogView[]
  favourites    Favourite[]
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Category {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  name       String   @unique @db.VarChar(255)
  creator_id String?  @db.VarChar(255)
  creator    User?    @relation(fields: [creator_id], references: [user_id], onDelete: SetNull)
  blogs      Blog[]
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([creator_id])
  @@map("categories")
}

model Blog {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now()) @db.Timestamptz(3)
  title       String      @db.VarChar(500)
  description String      @db.Text
  image       String?     @db.Text
  user_id     String      @db.VarChar(255)
  category_id Int?
  author      User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  category    Category?   @relation(fields: [category_id], references: [id], onDelete: SetNull)
  comments    Comment[]
  likes       BlogLike[]
  views       BlogView[]
  favourites  Favourite[]
  updated_at  DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([user_id])
  @@index([category_id])
  @@index([created_at, id])
  @@map("blogs")
}

model Comment {
  id                Int           @id @default(autoincrement())
  created_at        DateTime      @default(now()) @db.Timestamptz(3)
  blog_id           Int
  user_id           String        @db.VarChar(255)
  content           String        @db.Text
  parent_comment_id Int?
  blog              Blog          @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  author            User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  parent            Comment?      @relation("Replies", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies           Comment[]     @relation("Replies")
  likes             CommentLike[]
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([blog_id, created_at])
  @@index([user_id])
  @@index([parent_comment_id])
  @@map("comments")
}

model CommentLike {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  comment_id Int
  user_id    String   @db.VarChar(255)
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([comment_id, user_id])
  @@index([user_id])
  @@map("comment_likes")
}

model BlogLike {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  blog_id    Int
  user_id    String   @db.VarChar(255)
  blog       Blog     @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([blog_id, user_id])
  @@index([user_id])
  @@map("blog_likes")
}

model BlogView {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  blog_id    Int
  user_id    String   @db.VarChar(255)
  blog       Blog     @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  view_date  DateTime @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'UTC')::date)")) @db.Date

  @@index([blog_id, user_id, view_date])
  @@index([user_id])
  @@map("blog_views")
}

model Favourite {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(3)
  blog_id    Int
  user_id    String   @db.VarChar(255)
  blog       Blog     @relation(fields: [blog_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, blog_id])
  @@index([blog_id])
  @@map("favourites")
}
