# Prisma Postgres: direct for CLI, pooled for application traffic.
# For a local PostgreSQL server, both may point to the same LOCAL database.
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/my-blogs"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/my-blogs"
UPLOADTHING_TOKEN="REPLACE_ME"
RESEND_EMAIL_API_KEY="REPLACE_ME"
